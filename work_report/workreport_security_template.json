{
  "security_group_rules": {
    "inbound": [
      {
        "rule_name": "SSH管理访问",
        "protocol": "TCP",
        "port": "22",
        "source": "你的IP/32",
        "description": "仅允许管理员IP访问SSH",
        "priority": 1,
        "action": "ACCEPT"
      },
      {
        "rule_name": "HTTP网站访问", 
        "protocol": "TCP",
        "port": "80",
        "source": "0.0.0.0/0",
        "description": "允许所有用户HTTP访问",
        "priority": 1,
        "action": "ACCEPT"
      },
      {
        "rule_name": "HTTPS网站访问",
        "protocol": "TCP", 
        "port": "443",
        "source": "0.0.0.0/0",
        "description": "允许所有用户HTTPS访问",
        "priority": 1,
        "action": "ACCEPT"
      }
    ],
    "outbound": [
      {
        "rule_name": "所有出站流量",
        "protocol": "ALL",
        "port": "ALL", 
        "destination": "0.0.0.0/0",
        "description": "允许服务器访问外网",
        "priority": 1,
        "action": "ACCEPT"
      }
    ]
  },
  "blocked_ports": [
    {
      "port": 3306,
      "service": "MySQL",
      "reason": "数据库应仅内网访问"
    },
    {
      "port": 6379,
      "service": "Redis", 
      "reason": "缓存服务应仅内网访问"
    },
    {
      "port": 8000,
      "service": "Gunicorn",
      "reason": "应用服务通过Nginx代理访问"
    }
  ],
  "security_notes": [
    "定期更新SSH端口的授权IP",
    "监控安全组规则变更日志", 
