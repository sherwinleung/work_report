# WorkReport生产环境配置文件
# 复制到服务器后重命名为 .env

# Django基础配置
DEBUG=False
SECRET_KEY=your-super-secret-key-here-change-this-in-production
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,your-server-ip

# 数据库配置（MySQL示例）
DB_ENGINE=mysql
DB_NAME=workreport
DB_USER=workreport_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=3306

# 或者使用DATABASE_URL（适用于云数据库）
# DATABASE_URL=mysql://username:password@hostname:port/database_name

# Redis缓存配置
REDIS_URL=redis://127.0.0.1:6379/1

# HTTPS配置（如果使用）
USE_HTTPS=false

# 邮件配置（用于错误通知）
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=your-email@domain.com
ADMIN_EMAIL=564999607@qq.com

# API密钥配置
LLM_PROVIDER=deepseek
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com

# 默认API配置（用于新用户注册）
DEFAULT_OPENAI_API_KEY=sk-QLZDJaU1a8uuoYfdaN52FPzpoFFUmPlhEOmgmyMZ5g=
DEFAULT_OPENAI_API_BASE=https://llmhub.app
DEFAULT_DEEPSEEK_API_KEY=sk-d40ba7f7a4b242268876d3ca27d72684
DEFAULT_DEEPSEEK_API_BASE=https://api.deepseek.com

# Sentry错误监控（可选）
# SENTRY_DSN=your-sentry-dsn-here
